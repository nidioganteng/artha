# Salin file ini menjadi .env.local lalu isi dengan nilai dari Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hanya untuk seed demo — akun Supabase terpisah khusus pengujian
# Jangan gunakan akun pribadi yang berisi data asli
ARTHA_SEED_EMAIL=demo@example.com
ARTHA_SEED_PASSWORD=ganti-dengan-kata-sandi-akun-demo
